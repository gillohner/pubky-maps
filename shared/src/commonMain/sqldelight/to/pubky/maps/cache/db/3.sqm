-- Version 4: what the places the user wrote about are and where ("Café · Napfgasse 4, 8001 Zürich"),
-- for the lines under their names on the Saved page.

CREATE TABLE place_summary (
    place TEXT NOT NULL PRIMARY KEY,
    summary TEXT NOT NULL,
    -- 1 when the summary was taken while Pinakes could not be reached and no card was kept: the line of
    -- a page Pinakes answered replaces it.
    partial INTEGER NOT NULL DEFAULT 0
);
