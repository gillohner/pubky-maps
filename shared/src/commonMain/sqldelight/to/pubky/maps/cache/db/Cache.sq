-- The signed-in user's own Pubky data as last read from their homeserver, so it can be shown
-- without the network. One account at a time; everything is deleted on sign-out.

CREATE TABLE account (
    public_key TEXT NOT NULL PRIMARY KEY,
    name TEXT,
    -- When tags and saved places were last read in full (epoch milliseconds), null before that.
    refreshed_at INTEGER
);

CREATE TABLE tag (
    path TEXT NOT NULL PRIMARY KEY,
    place TEXT NOT NULL,
    label TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE bookmark (
    path TEXT NOT NULL PRIMARY KEY,
    place TEXT NOT NULL
);

-- Writes waiting to be sent to the homeserver, in order (see WriteOp).
CREATE TABLE outbox (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    op TEXT NOT NULL
);

-- The user's lists (collection posts) as last read or written, one JSON OwnList each.
CREATE TABLE own_list (
    uri TEXT NOT NULL PRIMARY KEY,
    private INTEGER NOT NULL,
    list TEXT NOT NULL
);

-- The user's posts that were read and are not lists: a post never changes its kind.
CREATE TABLE other_post (
    private INTEGER NOT NULL,
    id TEXT NOT NULL,
    PRIMARY KEY (private, id)
);

-- Names of places the user wrote about, for their saved places and lists.
CREATE TABLE place_label (
    place TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

account:
SELECT * FROM account LIMIT 1;

putAccount:
INSERT OR REPLACE INTO account(public_key, name, refreshed_at) VALUES (?, ?, ?);

tags:
SELECT * FROM tag ORDER BY created_at DESC, path;

putTag:
INSERT OR REPLACE INTO tag(path, place, label, created_at) VALUES (?, ?, ?, ?);

bookmarks:
SELECT * FROM bookmark ORDER BY place;

putBookmark:
INSERT OR REPLACE INTO bookmark(path, place) VALUES (?, ?);

deleteAccounts:
DELETE FROM account;

deleteTags:
DELETE FROM tag;

deleteBookmarks:
DELETE FROM bookmark;

outbox:
SELECT * FROM outbox ORDER BY seq;

putOutbox:
INSERT INTO outbox(op) VALUES (?);

lastSeq:
SELECT last_insert_rowid();

deleteOutboxItem:
DELETE FROM outbox WHERE seq = ?;

deleteOutbox:
DELETE FROM outbox;

ownLists:
SELECT list FROM own_list;

putOwnList:
INSERT OR REPLACE INTO own_list(uri, private, list) VALUES (?, ?, ?);

deleteOwnListsIn:
DELETE FROM own_list WHERE private = ?;

deleteOwnLists:
DELETE FROM own_list;

otherPosts:
SELECT id FROM other_post WHERE private = ?;

putOtherPost:
INSERT OR REPLACE INTO other_post(private, id) VALUES (?, ?);

deleteOtherPosts:
DELETE FROM other_post;

-- Where the places the user wrote about are (WGS84), for the pins of their saved places on the map.
CREATE TABLE place_point (
    place TEXT NOT NULL PRIMARY KEY,
    lat REAL NOT NULL,
    lon REAL NOT NULL
);

-- What the places the user wrote about are and where ("Café · Napfgasse 4, 8001 Zürich"), as their
-- page said when the user wrote: the line under their names on the Saved page.
CREATE TABLE place_summary (
    place TEXT NOT NULL PRIMARY KEY,
    summary TEXT NOT NULL
);

placeLabels:
SELECT * FROM place_label;

putPlaceLabel:
INSERT OR REPLACE INTO place_label(place, name) VALUES (?, ?);

deletePlaceLabels:
DELETE FROM place_label;

placePoints:
SELECT * FROM place_point;

putPlacePoint:
INSERT OR REPLACE INTO place_point(place, lat, lon) VALUES (?, ?, ?);

deletePlacePoints:
DELETE FROM place_point;

placeSummaries:
SELECT * FROM place_summary;

putPlaceSummary:
INSERT OR REPLACE INTO place_summary(place, summary) VALUES (?, ?);

deletePlaceSummaries:
DELETE FROM place_summary;
