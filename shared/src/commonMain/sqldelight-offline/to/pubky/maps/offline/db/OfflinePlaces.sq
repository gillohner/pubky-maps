-- The named places in the map tiles of each offline area, so search finds them without a
-- connection. Built from the tiles on the phone; deleted with the area.

-- An area whose places are here, read from its map data of new_data_at (OfflineMap.newDataAt).
CREATE TABLE area (
    id TEXT NOT NULL PRIMARY KEY,
    new_data_at INTEGER NOT NULL
);

CREATE TABLE place (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    area TEXT NOT NULL,
    name TEXT NOT NULL,
    -- Node, Way or Relation (OsmType's names); null for a place the tiles give no OpenStreetMap element for (streets)
    osm_type TEXT,
    osm_id INTEGER,
    tag_key TEXT NOT NULL,
    tag_value TEXT NOT NULL,
    category TEXT,
    lat REAL NOT NULL,
    lon REAL NOT NULL,
    -- The district and town it lies in, "Hottingen, Zürich" (Localities); null when no label reaches it
    locality TEXT
);

CREATE INDEX place_area ON place(area);

-- For a place page: the place by its OpenStreetMap element, the places near a point, the labels
-- around it (Localities).
CREATE INDEX place_osm ON place(osm_id, osm_type) WHERE osm_id IS NOT NULL;

CREATE INDEX place_point ON place(lat, lon);

CREATE INDEX place_label ON place(lat, lon) WHERE tag_key = 'place';

-- Each word of a place's name and category, as search compares them (normalizeForMatch), so a
-- typed word finds the places with a word that starts with it through the index.
CREATE TABLE word (
    word TEXT NOT NULL,
    place INTEGER NOT NULL
);

CREATE INDEX word_word ON word(word);

CREATE INDEX word_place ON word(place);

-- The OpenStreetMap details (opening hours, phone, website, ...) of the elements in each offline
-- area, fetched from Overpass when it was (fetched_at, epoch ms); kept apart from the places, which
-- are read again from the tiles at every map update.
CREATE TABLE details_area (
    id TEXT NOT NULL PRIMARY KEY,
    fetched_at INTEGER NOT NULL
);

CREATE TABLE details (
    area TEXT NOT NULL,
    osm_type TEXT NOT NULL,
    osm_id INTEGER NOT NULL,
    -- OSM tag names to values, a JSON object
    facts TEXT NOT NULL
);

CREATE INDEX details_osm ON details(osm_id, osm_type);

CREATE INDEX details_by_area ON details(area);

areas:
SELECT id, new_data_at FROM area;

putArea:
INSERT OR REPLACE INTO area(id, new_data_at) VALUES (?, ?);

insertPlace:
INSERT INTO place(area, name, osm_type, osm_id, tag_key, tag_value, category, lat, lon, locality) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setLocality:
UPDATE place SET locality = ? WHERE id = ?;

lastPlaceId:
SELECT last_insert_rowid();

insertWord:
INSERT INTO word(word, place) VALUES (?, ?);

deleteWords:
DELETE FROM word WHERE place IN (SELECT id FROM place WHERE area = ?);

deletePlaces:
DELETE FROM place WHERE area = ?;

deleteArea:
DELETE FROM area WHERE id = ?;

-- How many places have a word in [from, until): search looks the rarest typed word up.
countWordFrom:
SELECT COUNT(*) FROM word WHERE word >= :from AND word < :until;

-- How many places have the word itself.
countWord:
SELECT COUNT(*) FROM word WHERE word = :word;

-- The places with a word in [from, until), nearest to the point first (in degrees, which is
-- enough to pick the nearest few hundred).
withWordFrom:
SELECT DISTINCT place.* FROM word JOIN place ON place.id = word.place
WHERE word.word >= :from AND word.word < :until
ORDER BY (place.lat - :lat) * (place.lat - :lat) + (place.lon - :lon) * (place.lon - :lon)
LIMIT :limit;

-- The places with the word itself, town and district labels first (the stops named after a town
-- must not crowd out the town), then nearest to the point first.
withWord:
SELECT DISTINCT place.* FROM word JOIN place ON place.id = word.place
WHERE word.word = :word
ORDER BY place.tag_key = 'place' DESC, (place.lat - :lat) * (place.lat - :lat) + (place.lon - :lon) * (place.lon - :lon)
LIMIT :limit;

-- withWordFrom and withWord within a box around the point, through the index of the points: for a
-- word so common that its nearest places lie close by, where the word's index would read every
-- place that has it. withWordIn leaves out the town and district labels (labelsWithWord has them).
withWordFromIn:
SELECT place.* FROM place
WHERE place.lat BETWEEN :south AND :north AND place.lon BETWEEN :west AND :east
AND EXISTS (SELECT 1 FROM word WHERE word.place = place.id AND word.word >= :from AND word.word < :until)
ORDER BY (place.lat - :lat) * (place.lat - :lat) + (place.lon - :lon) * (place.lon - :lon)
LIMIT :limit;

withWordIn:
SELECT place.* FROM place
WHERE place.tag_key != 'place' AND place.lat BETWEEN :south AND :north AND place.lon BETWEEN :west AND :east
AND EXISTS (SELECT 1 FROM word WHERE word.place = place.id AND word.word = :word)
ORDER BY (place.lat - :lat) * (place.lat - :lat) + (place.lon - :lon) * (place.lon - :lon)
LIMIT :limit;

-- The town and district labels with the word, nearest to the point first.
labelsWithWord:
SELECT place.* FROM place
WHERE place.tag_key = 'place'
AND EXISTS (SELECT 1 FROM word WHERE word.place = place.id AND word.word = :word)
ORDER BY (place.lat - :lat) * (place.lat - :lat) + (place.lon - :lon) * (place.lon - :lon)
LIMIT :limit;

-- How many places lie in the box (read from the index of the points alone).
countIn:
SELECT COUNT(*) FROM place
WHERE lat BETWEEN :south AND :north AND lon BETWEEN :west AND :east;

-- The localities stored for an OpenStreetMap element, one per area that has it.
localitiesOf:
SELECT locality FROM place WHERE osm_id = :id AND osm_type = :type;

-- A place within the box, if any: a point with none near it lies outside every area's tiles.
anyIn:
SELECT id FROM place
WHERE lat BETWEEN :south AND :north AND lon BETWEEN :west AND :east
LIMIT 1;

-- The town and district labels in the box, which name a point in it (Localities).
labelsIn:
SELECT * FROM place
WHERE tag_key = 'place' AND lat BETWEEN :south AND :north AND lon BETWEEN :west AND :east;

detailsAreas:
SELECT id, fetched_at FROM details_area;

putDetailsArea:
INSERT OR REPLACE INTO details_area(id, fetched_at) VALUES (?, ?);

insertDetails:
INSERT INTO details(area, osm_type, osm_id, facts) VALUES (?, ?, ?, ?);

deleteDetails:
DELETE FROM details WHERE area = ?;

deleteDetailsArea:
DELETE FROM details_area WHERE id = ?;

-- The details of an OpenStreetMap element, from the area that fetched them last.
detailsOf:
SELECT details.facts, details_area.fetched_at FROM details JOIN details_area ON details_area.id = details.area
WHERE details.osm_id = :id AND details.osm_type = :type
ORDER BY details_area.fetched_at DESC
LIMIT 1;
