-- The named places in the map tiles of each offline area, so search finds them without a
-- connection. Built from the tiles on the phone; deleted with the area.

-- An area whose places are here, read from its map data of new_data_at (OfflineMap.newDataAt).
CREATE TABLE area (
    id TEXT NOT NULL PRIMARY KEY,
    new_data_at INTEGER NOT NULL
);

CREATE TABLE place (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    area TEXT NOT NULL,
    name TEXT NOT NULL,
    -- node, way or relation; null for a place the tiles give no OpenStreetMap element for (streets)
    osm_type TEXT,
    osm_id INTEGER,
    tag_key TEXT NOT NULL,
    tag_value TEXT NOT NULL,
    category TEXT,
    lat REAL NOT NULL,
    lon REAL NOT NULL
);

CREATE INDEX place_area ON place(area);

-- Each word of a place's name and category, as search compares them (normalizeForMatch), so a
-- typed word finds the places with a word that starts with it through the index.
CREATE TABLE word (
    word TEXT NOT NULL,
    place INTEGER NOT NULL
);

CREATE INDEX word_word ON word(word);

CREATE INDEX word_place ON word(place);

areas:
SELECT id, new_data_at FROM area;

putArea:
INSERT OR REPLACE INTO area(id, new_data_at) VALUES (?, ?);

insertPlace:
INSERT INTO place(area, name, osm_type, osm_id, tag_key, tag_value, category, lat, lon) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastPlaceId:
SELECT last_insert_rowid();

insertWord:
INSERT INTO word(word, place) VALUES (?, ?);

deleteWords:
DELETE FROM word WHERE place IN (SELECT id FROM place WHERE area = ?);

deletePlaces:
DELETE FROM place WHERE area = ?;

deleteArea:
DELETE FROM area WHERE id = ?;

-- How many places have a word in [from, until): search looks the rarest typed word up.
countWordFrom:
SELECT COUNT(*) FROM word WHERE word >= :from AND word < :until;

-- The places with a word in [from, until), nearest to the point first (in degrees, which is
-- enough to pick the nearest few hundred).
withWordFrom:
SELECT DISTINCT place.* FROM word JOIN place ON place.id = word.place
WHERE word.word >= :from AND word.word < :until
ORDER BY (place.lat - :lat) * (place.lat - :lat) + (place.lon - :lon) * (place.lon - :lon)
LIMIT :limit;
