-- What the user keeps on this phone only ("What is stored online": Phone only). Not tied to an
-- account: it stays when the user signs out, and it is never uploaded.

CREATE TABLE saved_place (
    place TEXT NOT NULL PRIMARY KEY,
    name TEXT,
    -- epoch milliseconds
    saved_at INTEGER NOT NULL,
    -- Where the place is (WGS84), for its pin on the map; null when the app did not know it.
    lat REAL,
    lon REAL,
    -- What and where it is ("Café · Napfgasse 4, 8001 Zürich"), as its page said when it was saved;
    -- null when the page knew neither.
    summary TEXT,
    -- 1 when the summary was taken while Pinakes could not be reached and no card was kept: the line of
    -- a page Pinakes answered replaces it.
    summary_partial INTEGER NOT NULL DEFAULT 0
);

-- One JSON OwnList per list.
CREATE TABLE phone_list (
    uri TEXT NOT NULL PRIMARY KEY,
    list TEXT NOT NULL
);

-- Things the app told the user once on this phone (e.g. that tags are public).
CREATE TABLE flag (
    name TEXT NOT NULL PRIMARY KEY
);

-- The geo: places the user saved or put in a list from the page of a point of its own (a dropped
-- pin, typed coordinates), as the core spells them: reopened from the Saved page or the map's
-- badge they are asked of no server. Other geo: places (a link from another app, a Pubky place)
-- are read as their link is. Phone only, also for places saved on the homeserver.
CREATE TABLE point_place (
    place TEXT NOT NULL PRIMARY KEY
);

savedPlaces:
SELECT * FROM saved_place ORDER BY saved_at DESC;

putSavedPlace:
INSERT OR REPLACE INTO saved_place(place, name, saved_at, lat, lon, summary, summary_partial) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSavedPlace:
DELETE FROM saved_place WHERE place = ?;

lists:
SELECT list FROM phone_list;

putList:
INSERT OR REPLACE INTO phone_list(uri, list) VALUES (?, ?);

flag:
SELECT name FROM flag WHERE name = ?;

putFlag:
INSERT OR REPLACE INTO flag(name) VALUES (?);

pointPlaces:
SELECT place FROM point_place;

putPointPlace:
INSERT OR REPLACE INTO point_place(place) VALUES (?);

deletePointPlace:
DELETE FROM point_place WHERE place = ?;
