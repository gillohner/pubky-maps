<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, the system's certificate authorities (Android's default, written out so the update
     probe's build can replace this file; src/updateProbe). The one exception: plain HTTP to a server
     on the phone itself (localhost, 127.0.0.1), the only http:// addresses Settings accepts
     (ServerUrl.cleartextHosts); traffic to them never leaves the device. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
